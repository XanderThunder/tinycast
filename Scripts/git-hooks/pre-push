#!/bin/bash
# The CI this fork lacks: lint and the test suite gate a branch push. See docs/development.md.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
checks=0
while read -r local_ref local_sha _ _; do
    [ "$local_sha" = "$zero" ] && continue
    case "$local_ref" in refs/tags/*) continue;; esac
    # The suite runs on the checkout, so it can only vouch for the commit that is checked out.
    if [ "$local_sha" != "$head" ]; then
        echo "✗ pre-push: $local_ref is not checked out; check it out to test it before pushing." >&2
        exit 1
    fi
    checks=1
done
[ "$checks" -eq 1 ] || exit 0

if ! git diff --quiet HEAD --; then
    echo "✗ pre-push: uncommitted changes would be tested instead of the commit; commit or stash them." >&2
    exit 1
fi

if grep -rln 'import AppKit\|import SwiftUI\|import Cocoa' Tinycast/Features/*/Model/; then
    echo "✗ pre-push: the files above import a UI framework under Features/*/Model/." >&2
    exit 1
fi
./Scripts/lint.sh || exit 1
./Scripts/run-tests.sh || exit 1
